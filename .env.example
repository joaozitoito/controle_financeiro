# Usado só pelo Docker Compose. Copie para .env e troque os marcadores.
# Use só letras e números na senha: ela entra na URL do banco.
POSTGRES_PASSWORD=SUBSTITUA_POR_SENHA_LOCAL

# Só para a VPS (compose.vps.yaml): domínio que aponta para o IP do servidor, sem https://
# nem barra. Com localhost dá para testar o modo VPS na própria máquina.
DOMINIO=localhost
